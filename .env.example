# Canonical public identity remains https://aurexbusinesslab.com.
NEXT_PUBLIC_SITE_URL=https://aurexbusinesslab.com
# Server only. Required for native production contact delivery.
GHL_WEBHOOK_URL=
LEAD_DEV_MODE=false
# Legacy settings retained for compatibility; the contact page uses its native form.
NEXT_PUBLIC_GHL_FORM_EMBED_URL=
NEXT_PUBLIC_GHL_CALENDAR_EMBED_URL=
NEXT_PUBLIC_GHL_AUDIT_URL=
NEXT_PUBLIC_ZOOM_REGISTRATION_URL=
NEXT_PUBLIC_GHL_WEBINAR_FORM_URL=
# Set both to a real occurrence with explicit UTC offset. Keep current.
WEBINAR_START_ISO=
WEBINAR_END_ISO=
# Ads funnel at /call. See docs/ADS_FUNNEL.md. Videos must be Vimeo or Wistia links.
# Server only. Every /call submission goes here and never to GHL_WEBHOOK_URL.
FUNNEL_WEBHOOK_URL=
FUNNEL_VSL_URL=
# Optional local thumbnail, for example /brand/vsl-thumb.webp.
FUNNEL_VSL_POSTER=
# Calendly or GHL booking URL. Set its post-booking redirect to /call/booked.
FUNNEL_CALENDAR_URL=
FUNNEL_CONFIRM_VIDEO_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
SITE_LEGAL_NAME=
# State whose law governs the website terms, for example Mississippi. Confirm with counsel.
SITE_LEGAL_STATE=
SITE_FOUNDER_NAME=
SITE_FOUNDER_BIO=
# Local public image path, for example /brand/founder.webp, after approval.
SITE_FOUNDER_PHOTO=
SITE_FOUNDED_YEAR=
SITE_ADDRESS=
SITE_LINKEDIN_URL=
SITE_YOUTUBE_URL=
SITE_FACEBOOK_URL=
# Services are disabled when their IDs are absent or empty.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# GoHighLevel external tracking ID (tk_...). Records visits and form submissions for CRM attribution.
NEXT_PUBLIC_GHL_TRACKING_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
ALLOW_GPTBOT=false
